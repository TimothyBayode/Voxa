{
  "name": "voxa-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && esbuild src/server.ts --bundle --platform=node --target=node18 --outdir=dist --format=esm --external:express --external:cors",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "assemblyai": "^4.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.12",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.21.3",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
